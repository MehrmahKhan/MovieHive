# SQL Server Database Configuration
DB_SERVER=DESKTOP-your-computer-name\\SQLEXPRESS
DB_NAME=MovieDB
DB_USER=moviehive_app
DB_PASSWORD=your_password_here

# SQL Server TCP Port (usually 1433 for SQLEXPRESS)
# If unsure, run in PowerShell as admin:
# Get-ItemProperty -Path 'HKLM:\SOFTWARE\Microsoft\Microsoft SQL Server\MSSQL*\MSSQLServer\SuperSocketNetLib\Tcp\IPAll' | Select-Object TcpPort
DB_PORT=1433

# Backend Node.js Server Port
PORT=3001
